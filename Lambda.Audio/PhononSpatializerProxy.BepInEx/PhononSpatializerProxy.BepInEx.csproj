<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <DefineConstants>$(DefineConstants);SPT_4_0;STEAMAUDIO_ENABLED</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- <AllowUnsafeBlocks>true</AllowUnsafeBlocks> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>0649,0169,0414,NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".\.Binaries*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExPath)\core\0Harmony.dll" />
    <Reference Include="$(BepInExPath)\core\BepInEx.dll" />

    <Reference Include="..\..\.Binaries\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhononSpatializerProxy\PhononSpatializerProxy.csproj" />
  </ItemGroup>

  <Target Name="CopyFilesAfterBuild" AfterTargets="Build">

    <ItemGroup>
      <Binaries Include="../../.Binaries/audioplugin_phonon.dll" />
      <Binaries Include="../../.Binaries/phonon.dll" />

      <FilesToCopyToPlugins Include="$(OutputPath)\$(MSBuildProjectName).dll" />
    </ItemGroup>

    <Copy SourceFiles="@(Binaries)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp\Binaries" SkipUnchangedFiles="true" />

    <!-- <Copy SourceFiles="@(FilesToCopyToPlugins)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp" /> -->
  </Target>
</Project>