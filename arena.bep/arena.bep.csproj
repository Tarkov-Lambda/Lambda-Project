<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ifp.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <DefineConstants>$(DefineConstants);SPT_4_0;STEAMAUDIO_ENABLED</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>0649,0169,0414,NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".\configs\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\deps\libraries*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SPTPath)\BepInEx\core\0Harmony.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\core\BepInEx.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\BepInEx\plugins\Fika\Fika.Core.dll">
      <Private>False</Private>
    </Reference>

    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\ItemComponent.Types.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.Unity.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.AudioModule.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Meta.XR.Audio.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\DissonanceVoip.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.Postprocessing.Runtime.dll">
      <Private>False</Private>
    </Reference>

    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\DOTween.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\DOTween.Modules.dll">
      <Private>False</Private>
    </Reference>

    <Reference Include="$(SPTPath)\BepInEx\plugins\UnityToolkit\*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="..\deps\libraries\*.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\arena.shared\arena.shared.csproj">
      <Private>False</Private>
    </ProjectReference>

    <ProjectReference Include="..\arena.ui\arena.ui.csproj">
      <Private>False</Private>
    </ProjectReference>

    <ProjectReference Include="..\arena.audio\arena.audio.csproj">
      <Private>False</Private>
    </ProjectReference>


    <ProjectReference Include="..\Tracer\tracer.csproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <Target Name="PrintConfig" BeforeTargets="Build">
    <Message Text="CONFIGURATION: $(Configuration)" Importance="High" />
  </Target>


  <Target Name="CopyFilesAfterBuild" AfterTargets="Build">


    <ItemGroup>
      <Dependencies Include="../deps/libraries/MemoryPack.Core.dll" />
      <Dependencies Include="../deps/libraries/System.Collections.Immutable.dll" />
      <!-- <Dependencies Include="../deps/libraries/UniTask.dll" />
      <Dependencies Include="../deps/libraries/UniTask.*.dll" /> -->
      <Dependencies Include="../deps/libraries/audioplugin_phonon.dll" />
      <Dependencies Include="../deps/libraries/phonon.dll" />

      <DebugDependencies Include="../deps/libraries/ScriptEngine.dll"
        Condition="'$(Configuration)' == 'Debug'" />
      <DebugDependencies Include="$(OutputPath)\tracer.dll"
        Condition="'$(Configuration)' == 'Debug'" />

      <FilesToCopyToScripts Include="$(OutputPath)\$(MSBuildProjectName).dll" />
      <FilesToCopyToScripts Include="$(OutputPath)\$(MSBuildProjectName).pdb" />

      <FilesToCopyToPlugins Include="$(OutputPath)\$(MSBuildProjectName).dll" />

      <Configs Include="../deps/configs/*.cfg" />
      <JSON Include="../deps/configs/*.jsonc" />

      <Bundles Include="../bundles/*" />
    </ItemGroup>


    <Copy SourceFiles="@(Dependencies)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp\deps" />
    <Copy SourceFiles="@(DebugDependencies)" DestinationFolder="$(SPTPath)\BepInEx\plugins\" />

    <Copy SourceFiles="@(Configs)" DestinationFolder="$(SPTPath)\BepInEx\config\" />
    <Copy SourceFiles="@(JSON)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp\json\" />

    <Copy SourceFiles="@(Bundles)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp\bundles" />


    <Copy SourceFiles="@(FilesToCopyToScripts)" DestinationFolder="$(SPTPath)\BepInEx\scripts\ifp"
      Condition="'$(Configuration)' == 'Debug'" />
    <Copy SourceFiles="@(FilesToCopyToPlugins)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp"
      Condition="'$(Configuration)' == 'Release'" />
  </Target>

  <Target Name="DeleteConflictingLibraries" AfterTargets="CopyFilesAfterBuild">
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <ReleaseConflicts Include="$(SPTPath)\BepInEx\scripts\ifp\arena.bep.dll" />
      <ReleaseConflicts Include="$(SPTPath)\BepInEx\scripts\ifp\arena.bep.pdb" />
    </ItemGroup>

    <Delete Files="@(ReleaseConflicts)" Condition="'$(Configuration)' == 'Release'" />

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <DebugConflicts Include="$(SPTPath)\BepInEx\plugins\ifp\arena.bep.dll" />
    </ItemGroup>

    <Delete Files="@(DebugConflicts)" Condition="'$(Configuration)' == 'Debug'" />
  </Target>

  <!-- Make Release Zip -->
  <Target Name="CreateBuild" AfterTargets="DeleteConflictingLibraries"
    Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <BuildOutputDir>$(SPTPath)\BepInEx</BuildOutputDir>
      <ZipOutput>$(SolutionDir)builds\$(MSBuildProjectName).zip</ZipOutput>
    </PropertyGroup>

    <ZipDirectory SourceDirectory="$(SPTPath)\BepInEx\plugins\ifp" DestinationFile="$(ZipOutput)"
      Overwrite="true" />
  </Target>

</Project>