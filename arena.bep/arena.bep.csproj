<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ifp.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <DefineConstants>$(DefineConstants);SPT_4_0;STEAMAUDIO_ENABLED</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Product>Lambda</Product>
    <Version>0.6.15</Version>
    <Description>Made by ifp and tarkin</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>0649,0169,0414,NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".\configs\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".\deps\libraries*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx / SPT -->
    <Reference Include="$(BepInExPath)\core\0Harmony.dll" />
    <Reference Include="$(BepInExPath)\core\BepInEx.dll" />
    <Reference Include="$(BepInExPath)\plugins\spt\spt-reflection.dll" />
    <Reference Include="$(BepInExPath)\plugins\Fika\Fika.Core.dll" />

    <!-- EFT -->
    <Reference Include="$(ManagedPath)\ItemComponent.Types.dll" />
    <Reference Include="$(ManagedPath)\ItemTemplate.Types.dll" />
    <Reference Include="$(ManagedPath)\Assembly-CSharp.dll" />
    <Reference Include="$(ManagedPath)\bsg.console.core.dll" />
    <Reference Include="$(ManagedPath)\Comfort.Unity.dll" />
    <Reference Include="$(ManagedPath)\Comfort.dll" />
    <Reference Include="$(ManagedPath)\Newtonsoft.Json.dll" />
    <Reference Include="$(ManagedPath)\Sirenix.Serialization.dll" />
    <Reference Include="$(ManagedPath)\UnityEngine.AudioModule.dll" />
    <Reference Include="$(ManagedPath)\UnityEngine.UI.dll" />
    <Reference Include="$(ManagedPath)\Unity.TextMeshPro.dll" />
    <Reference Include="$(ManagedPath)\Meta.XR.Audio.dll" />
    <Reference Include="$(ManagedPath)\DissonanceVoip.dll" />
    <Reference Include="$(ManagedPath)\Unity.Postprocessing.Runtime.dll" />
    <Reference Include="$(ManagedPath)\DOTween.dll" />
    <Reference Include="$(ManagedPath)\DOTween.Modules.dll" />

    <Reference Include="..\deps\libraries\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\arena.shared\arena.shared.csproj" />

    <ProjectReference Include="..\arena.ui\arena.ui.csproj" />

    <ProjectReference Include="..\arena.audio\SteamAudioUnity.csproj" />

    <ProjectReference Include="..\PacketHandler\PacketHandler.csproj" />
  </ItemGroup>

  <Target Name="CopyFilesAfterBuild" AfterTargets="Build">


    <ItemGroup>
      <Dependencies Include="../deps/libraries/audioplugin_phonon.dll" />
      <Dependencies Include="../deps/libraries/phonon.dll" />

      <Dependencies Include="$(OutputPath)\Unitask.dll" />
      <Dependencies Include="$(OutputPath)\Unitask.*.dll" />

      <DebugDependencies Include="../deps/libraries/ScriptEngine.dll" Condition="'$(Configuration)' == 'Debug'" />
      <DebugDependencies Include="$(OutputPath)\tracer.dll" Condition="'$(Configuration)' == 'Debug'" />

      <FilesToCopyToScripts Include="$(OutputPath)\$(MSBuildProjectName).dll" />
      <FilesToCopyToScripts Include="$(OutputPath)\$(MSBuildProjectName).pdb" />

      <FilesToCopyToPlugins Include="$(OutputPath)\$(MSBuildProjectName).dll" />

      <Configs Include="../deps/configs/*.cfg" />
      <Presets Include="../deps/configs/Presets/WeaponBuilds/*.json" />
      <JSON Include="../deps/configs/*.jsonc" />
    </ItemGroup>


    <Copy SourceFiles="@(Dependencies)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp\deps" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(DebugDependencies)" DestinationFolder="$(SPTPath)\BepInEx\plugins\" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />

    <Copy SourceFiles="@(Configs)" DestinationFolder="$(SPTPath)\BepInEx\config\" />
    <Copy SourceFiles="@(JSON)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp\json\" />

    <Copy SourceFiles="@(Presets)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp\json\Presets\WeaponBuilds\" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />

    <Copy SourceFiles="@(FilesToCopyToScripts)" DestinationFolder="$(SPTPath)\BepInEx\scripts\ifp" Condition="'$(Configuration)' == 'Debug'" />
    <Copy SourceFiles="@(FilesToCopyToPlugins)" DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp" Condition="'$(Configuration)' == 'Release'" />
  </Target>

  <Target Name="DeleteConflictingLibraries" AfterTargets="CopyFilesAfterBuild">
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <ReleaseConflicts Include="$(SPTPath)\BepInEx\scripts\ifp\$(MSBuildProjectName).dll" />
      <ReleaseConflicts Include="$(SPTPath)\BepInEx\scripts\ifp\$(MSBuildProjectName).pdb" />
    </ItemGroup>

    <Delete Files="@(ReleaseConflicts)" Condition="'$(Configuration)' == 'Release'" />

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <DebugConflicts Include="$(SPTPath)\BepInEx\plugins\ifp\$(MSBuildProjectName).dll" />
    </ItemGroup>

    <Delete Files="@(DebugConflicts)" Condition="'$(Configuration)' == 'Debug'" />
  </Target>

  <Target Name="CreateBuild" AfterTargets="DeleteConflictingLibraries" Condition="'$(Configuration)' == 'Release'">

    <PropertyGroup>
      <ZipOutput>$(SolutionDir)builds\Lambda-$(Version).zip</ZipOutput>
      <StagingDir>$(BaseIntermediateOutputPath)zip_staging</StagingDir>
    </PropertyGroup>

    <!-- Clean staging folder -->
    <RemoveDir Directories="$(StagingDir)" />
    <MakeDir Directories="$(StagingDir)\BepInEx\plugins\ifp" />

    <!-- Copy plugin output -->
    <ItemGroup>
      <PluginFiles Include="$(SPTPath)\BepInEx\plugins\ifp\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(StagingDir)\BepInEx\plugins\ifp\%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- Create zip from staging -->
    <ZipDirectory SourceDirectory="$(StagingDir)" DestinationFile="$(ZipOutput)" Overwrite="true" />

  </Target>

</Project>