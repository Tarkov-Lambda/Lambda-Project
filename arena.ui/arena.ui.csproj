<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>ifp.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <DefineConstants>$(DefineConstants);EFT_RUNTIME</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\arena.shared\arena.shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyFilesAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <FilesToCopy Include="$(OutputPath)\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)"
      DestinationFolder="$(SPTPath)\BepInEx\plugins\ifp"
      SkipUnchangedFiles="true"
      ContinueOnError="WarnAndContinue" />
  </Target>
</Project>