#pragma kernel CS_Clear              // 0
#pragma kernel CS_VoxelizeMesh       // 1
#pragma kernel CS_Seed               // 2
#pragma kernel CS_FillStep           // 3  — frontier-based, indirect dispatch, InterlockedMax
#pragma kernel CS_ClearSmokeTexture  // 4  — clears _SmokeVoxelTex on smoke reset
#pragma kernel CS_SeedRadiusRing     // 5  — adds newly-radius-entered voxels to frontier
#pragma kernel CS_BuildDispatchArgs  // 6  — builds indirect args, resets write counter

RWStructuredBuffer<int>  _Voxels;
RWStructuredBuffer<int>  _SmokeVoxels;
RWStructuredBuffer<int>  _StaticVoxels;

// Frontier: double-buffered flat lists of active voxel indices (swapped each frame in C#)
RWStructuredBuffer<uint> _FrontierRead;       // this frame's wavefront
RWStructuredBuffer<uint> _FrontierWrite;      // next frame's wavefront (atomically accumulated)
RWStructuredBuffer<uint> _FrontierReadCount;  // [1] — number of valid entries in _FrontierRead
RWStructuredBuffer<uint> _FrontierWriteCount; // [1] — atomic counter for _FrontierWrite
RWStructuredBuffer<uint> _DispatchArgs;       // [3] — x/y/z group counts for DispatchIndirect

// Smoke occupancy texture: normalized [0,1] = voxelValue / maxFillSteps.
// Written only when voxel values change; read by raymarcher via hardware trilinear sampler.
RWTexture3D<float> _SmokeVoxelTex;

StructuredBuffer<float3> _MeshVertices;
StructuredBuffer<int>    _MeshTriangleIndices;
float4x4 _MeshLocalToWorld;

float3 _VoxelResolution, _BoundsExtent;
float3 _Radius, _PrevRadius;
float3 _SmokeOrigin;
uint   _VoxelCount, _TriangleCount;
float  _VoxelSize, _IntersectionBias;

int  _MaxFillSteps;
uint _FrontierCapacity;


// ── Index helpers ─────────────────────────────────────────────────────────────

uint to1D(uint3 pos) {
    return pos.x + pos.y * _VoxelResolution.x + pos.z * _VoxelResolution.x * _VoxelResolution.y;
}

uint3 to3D(uint idx) {
    uint3 r = uint3(_VoxelResolution);
    return uint3(idx % r.x, (idx / r.x) % r.y, idx / (r.x * r.y));
}

static int3 offsets[6] = {
    int3( 1,  0,  0), int3(-1,  0,  0),
    int3( 0,  1,  0), int3( 0, -1,  0),
    int3( 0,  0,  1), int3( 0,  0, -1)
};


// ── Triangle-AABB SAT intersection (from https://bronsonzgeb.com/index.php/2021/05/29/gpu-mesh-voxelizer-part-2/) ──

struct Triangle { float3 a, b, c; };
struct AABB     { float3 center, extents; };

bool IntersectsTriangleAabbSat(float3 v0, float3 v1, float3 v2, float3 ext, float3 axis) {
    float p0 = dot(v0, axis), p1 = dot(v1, axis), p2 = dot(v2, axis);
    float r = ext.x * abs(dot(float3(1,0,0), axis))
            + ext.y * abs(dot(float3(0,1,0), axis))
            + ext.z * abs(dot(float3(0,0,1), axis));
    return !(max(-max(p0, max(p1, p2)), min(p0, min(p1, p2))) > r);
}

bool IntersectsTriangleAabb(Triangle tri, AABB aabb) {
    tri.a -= aabb.center; tri.b -= aabb.center; tri.c -= aabb.center;
    float3 ab = normalize(tri.b - tri.a);
    float3 bc = normalize(tri.c - tri.b);
    float3 ca = normalize(tri.a - tri.c);

    float3 a00 = float3(0, -ab.z,  ab.y), a01 = float3(0, -bc.z,  bc.y), a02 = float3(0, -ca.z,  ca.y);
    float3 a10 = float3( ab.z, 0, -ab.x), a11 = float3( bc.z, 0, -bc.x), a12 = float3( ca.z, 0, -ca.x);
    float3 a20 = float3(-ab.y, ab.x, 0),  a21 = float3(-bc.y, bc.x, 0),  a22 = float3(-ca.y, ca.x, 0);

    if (!IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a00) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a01) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a02) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a10) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a11) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a12) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a20) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a21) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, a22) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, float3(1,0,0)) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, float3(0,1,0)) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, float3(0,0,1)) ||
        !IntersectsTriangleAabbSat(tri.a, tri.b, tri.c, aabb.extents, cross(ab, bc)))
        return false;
    return true;
}


// ── Kernels ───────────────────────────────────────────────────────────────────

[numthreads(4, 4, 8)]
void CS_Clear(uint3 id : SV_DISPATCHTHREADID) {
    if (any(id >= uint3(_VoxelResolution))) return;
    _Voxels[to1D(id)] = 0;
}

[numthreads(4, 4, 8)]
void CS_VoxelizeMesh(uint3 id : SV_DISPATCHTHREADID) {
    if (any(id >= uint3(_VoxelResolution))) return;
    uint idx = to1D(id);
    float halfVoxelSize = _VoxelSize * 0.5f;
    float3 centerPos = float3(id) * _VoxelSize + halfVoxelSize;
    centerPos.xz -= _BoundsExtent.xz;

    AABB aabb;
    aabb.center  = centerPos;
    aabb.extents = halfVoxelSize * _IntersectionBias;

    for (uint i = 0; i < _TriangleCount; i += 3) {
        Triangle tri;
        tri.a = mul(_MeshLocalToWorld, float4(_MeshVertices[_MeshTriangleIndices[i    ]], 1.0f)).xyz;
        tri.b = mul(_MeshLocalToWorld, float4(_MeshVertices[_MeshTriangleIndices[i + 1]], 1.0f)).xyz;
        tri.c = mul(_MeshLocalToWorld, float4(_MeshVertices[_MeshTriangleIndices[i + 2]], 1.0f)).xyz;
        [branch]
        if (IntersectsTriangleAabb(tri, aabb)) {
            _StaticVoxels[idx] = 1;
            return;
        }
    }
}

// Seeds the smoke origin voxel and populates the initial frontier with its 6 neighbors.
// Called once per smoke throw. Must be dispatched (1,1,1).
[numthreads(1, 1, 1)]
void CS_Seed(uint3 id : SV_DISPATCHTHREADID) {
    float3 seedPos = _SmokeOrigin % _BoundsExtent;
    seedPos.xz += _BoundsExtent.xz;
    seedPos /= _BoundsExtent * 2;
    seedPos *= _VoxelResolution;

    uint seedIdx = to1D(uint3(seedPos));
    _SmokeVoxels[seedIdx] = _MaxFillSteps;
    _SmokeVoxelTex[uint3(seedPos)] = 1.0f;

    // Reset write counter and seed the initial frontier
    _FrontierWriteCount[0] = 0;
    int3 seedPosI = int3(seedPos);
    for (int o = 0; o < 6; ++o) {
        int3 nPos = seedPosI + offsets[o];
        if (any(nPos < 0) || any(nPos >= int3(_VoxelResolution))) continue;
        uint writeIdx;
        InterlockedAdd(_FrontierWriteCount[0], 1, writeIdx);
        if (writeIdx < _FrontierCapacity)
            _FrontierWrite[writeIdx] = to1D(uint3(nPos));
    }
}

// Clears the smoke voxel texture to 0 on smoke reset.
[numthreads(4, 4, 8)]
void CS_ClearSmokeTexture(uint3 id : SV_DISPATCHTHREADID) {
    if (any(id >= uint3(_VoxelResolution))) return;
    _SmokeVoxelTex[id] = 0.0f;
}

// 3D sweep that detects voxels entering the radius ellipsoid this frame and adds
// them to the WRITE frontier for the next CS_FillStep pass. Cheap: only touches
// the thin ring at the current radius boundary, all others exit immediately.
[numthreads(4, 4, 8)]
void CS_SeedRadiusRing(uint3 id : SV_DISPATCHTHREADID) {
    if (any(id >= uint3(_VoxelResolution))) return;

    uint idx = to1D(id);
    if (_SmokeVoxels[idx] > 0) return; // already active

    float3 pos = float3(id) * _VoxelSize + _VoxelSize * 0.5f
                 - float3(_BoundsExtent.x, 0, _BoundsExtent.z) - _SmokeOrigin;

    float3 safeRadius     = max(_Radius,     0.0001f);
    float3 safePrevRadius = max(_PrevRadius, 0.0001f);

    float dist     = length(pos / safeRadius);
    float prevDist = length(pos / safePrevRadius);

    // Only voxels that just crossed the radius boundary this frame
    if (dist <= 1.0f && prevDist > 1.0f) {
        uint writeIdx;
        InterlockedAdd(_FrontierWriteCount[0], 1, writeIdx);
        if (writeIdx < _FrontierCapacity)
            _FrontierWrite[writeIdx] = idx;
    }
}

// Reads the current frontier count and writes DispatchIndirect args for CS_FillStep.
// Also resets _FrontierWriteCount to 0 so CS_FillStep and CS_SeedRadiusRing can
// accumulate into it. Must be dispatched (1,1,1) before CS_FillStep.
[numthreads(1, 1, 1)]
void CS_BuildDispatchArgs(uint3 id : SV_DISPATCHTHREADID) {
    uint count = _FrontierReadCount[0];
    // ceil(count/128); when count==0 this gives 0 → DispatchIndirect launches no threads
    _DispatchArgs[0] = (count + 127u) / 128u;
    _DispatchArgs[1] = 1u;
    _DispatchArgs[2] = 1u;
    // Reset write counter — CS_FillStep and CS_SeedRadiusRing will atomically fill it
    _FrontierWriteCount[0] = 0u;
}

// Frontier-based fill step. One thread per active frontier voxel (indirect dispatch).
// Uses InterlockedMax for race-free direct writes — no ping-pong buffer needed.
// Writes updated values into both _SmokeVoxels (for next-frame neighbors) and
// _SmokeVoxelTex (for hardware-sampled raymarcher reads). Only voxels whose value
// actually improves propagate their neighbors, keeping the frontier minimal.
[numthreads(128, 1, 1)]
void CS_FillStep(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= _FrontierReadCount[0]) return;

    uint  voxelIdx = _FrontierRead[id.x];
    uint3 voxelPos = to3D(voxelIdx);

    float3 centerPos = float3(voxelPos) * _VoxelSize + _VoxelSize * 0.5f
                       - float3(_BoundsExtent.x, 0, _BoundsExtent.z) - _SmokeOrigin;

    float3 safeRadius = max(_Radius, 0.0001f);
    if (length(centerPos / safeRadius) > 1.0f) return; // outside radius, CS_SeedRadiusRing will re-add

    int staticVoxel = _StaticVoxels[voxelIdx];
    int3 voxelPosI  = int3(voxelPos);

    int bestNeighbor = 0;
    for (int o = 0; o < 6; ++o) {
        int3 samplePos = voxelPosI + offsets[o];
        if (any(samplePos < 0) || any(samplePos >= int3(_VoxelResolution))) continue;
        int v = _SmokeVoxels[to1D(uint3(samplePos))];
        bestNeighbor = max(bestNeighbor, v);
    }

    int newVal = max(0, bestNeighbor - 1);
    if (staticVoxel > 0 && newVal > 2) newVal = 2;
    if (newVal <= 0) return;

    // Atomic write — replaces ping-pong double-buffer
    int originalVal;
    InterlockedMax(_SmokeVoxels[voxelIdx], newVal, originalVal);

    if (newVal > originalVal) {
        // Update texture for hardware-trilinear raymarcher reads
        _SmokeVoxelTex[voxelPos] = float(newVal) / float(_MaxFillSteps);

        // Add neighbors that can still improve to the next frontier
        for (int o2 = 0; o2 < 6; ++o2) {
            int3 nPos = voxelPosI + offsets[o2];
            if (any(nPos < 0) || any(nPos >= int3(_VoxelResolution))) continue;
            uint nIdx = to1D(uint3(nPos));
            if (_SmokeVoxels[nIdx] < newVal - 1) {
                uint writeIdx;
                InterlockedAdd(_FrontierWriteCount[0], 1, writeIdx);
                if (writeIdx < _FrontierCapacity)
                    _FrontierWrite[writeIdx] = nIdx;
            }
        }
    }
}
