#pragma kernel CS_GenerateNoise       // 0
#pragma kernel CS_DebugNoise          // 1
#pragma kernel CS_RayMarchSmoke       // 2
#pragma kernel CS_BuildBulletHoleMask // 3  — bakes animated bullet holes into a 3D mask texture

#define STEPS 256
#define MIN_HIT_DISTANCE 0.001
#define MAX_DISTANCE 200
#define PI 3.1415926538

// Smoke occupancy — read-only in all raymarching kernels.
// Written by Voxelize.compute (CS_FillStep / CS_Seed). Hardware trilinear sampler
// replaces the old manual 8-tap getTrilinearVoxel() function entirely.
Texture3D<float>   _SmokeVoxelTex;

// Bullet hole mask — written by CS_BuildBulletHoleMask, read by CS_RayMarchSmoke.
// Stores values in [0,1]: 1 = full smoke, ~0 = burned through.
// Noise is NOT baked here; it's applied at sample time in getDensity() so edge
// softening remains view-consistent without texture aliasing.
RWTexture3D<float> _BulletHoleMaskTexRW; // write slot for CS_BuildBulletHoleMask
Texture3D<float>   _BulletHoleMaskTex;   // read slot for CS_RayMarchSmoke

RWTexture3D<half>  _RWNoiseTex;
Texture3D<half>    _NoiseTex;
SamplerState point_repeat_sampler;
SamplerState linear_repeat_sampler;
SamplerState linear_clamp_sampler;

RWTexture2D<float4> _SmokeTex;
RWTexture2D<half>   _SmokeMaskTex;
Texture2D<half>     _DepthTex;

float3   _CameraWorldPos;
float3   _LightColor;
float3   _SunDirection;
float4x4 _CameraToWorld;
float4x4 _CameraInvProjection;
float4x4 _CameraInvViewProjection;
int      _BufferWidth, _BufferHeight;
float    _FrameTime;

float3 _Radius;
float4 _CubeParams;
float3 _SmokeOrigin;
float  _BulletDepth;

int   _StepCount, _LightStepCount;
float _StepSize, _LightStepSize;
float _SmokeSize;
float _VolumeDensity, _ShadowDensity;
float _AbsorptionCoefficient, _ScatteringCoefficient;
float3 _SmokeColor, _ExtinctionColor;
float  _G;
float  _DensityFalloff;
int    _PhaseFunction;
float  _AlphaThreshold;

float3 _AnimationDirection;

float3 _NoiseRes;
int    _Octaves;
float  _Amplitude, _Warp, _Add;
int    _CellSize, _AxisCellCount, _InvertNoise, _Seed;

// Used by CS_BuildBulletHoleMask and early-out traversal
float3 _VoxelResolution, _BoundsExtent;
float  _VoxelSize;

// Set to 1 on platforms where render-texture Y starts at the top (D3D, Metal).
// Passed from C# via SystemInfo.graphicsUVStartsAtTop.
// When set, the per-pixel UV derived from thread-ID is flipped on Y so that
// it matches the orientation that the composite shader will sample _SmokeTex with.
int _FlipY;

struct BulletHole {
    float3 origin;
    float3 forward;
    float2 radius;
};
RWStructuredBuffer<BulletHole> _BulletHoles;
int _BulletHoleCount;


// ── Noise ─────────────────────────────────────────────────────────────────────

float hash(uint n) {
    n = (n << 13U) ^ n;
    n = n * (n * n * 15731U + 0x789221U) + 0x1376312589U;
    return float(n & uint(0x7fffffffU)) / float(0x7fffffff);
}

float worley(float3 coord, int axisCellCount) {
    int3 cell = floor(coord / _CellSize);
    float3 localSamplePos = float3(coord / _CellSize - cell);
    float dist = 1.0f;

    for (int x = -1; x <= 1; ++x) {
        for (int y = -1; y <= 1; ++y) {
            for (int z = -1; z <= 1; ++z) {
                int3 cellCoordinate = cell + int3(x, y, z);
                int cx = cellCoordinate.x, cy = cellCoordinate.y, cz = cellCoordinate.z;
                if (cx == -1 || cx == axisCellCount || cy == -1 || cy == axisCellCount || cz == -1 || cz == axisCellCount) {
                    int3 wrapped = fmod(cellCoordinate + axisCellCount, (int3)axisCellCount);
                    int wi = wrapped.x + axisCellCount * (wrapped.y + wrapped.z * axisCellCount);
                    float3 fp = cellCoordinate + float3(hash(_Seed + wi), hash(_Seed + wi * 2), hash(_Seed + wi * 3));
                    dist = min(dist, distance(cell + localSamplePos, fp));
                } else {
                    int ci = cellCoordinate.x + axisCellCount * (cellCoordinate.y + cellCoordinate.z * axisCellCount);
                    float3 fp = cellCoordinate + float3(hash(_Seed + ci), hash(_Seed + ci * 2), hash(_Seed + ci * 3));
                    dist = min(dist, distance(cell + localSamplePos, fp));
                }
            }
        }
    }
    dist = sqrt(1.0f - dist * dist);
    dist *= dist * dist * dist * dist * dist;
    return dist;
}

[numthreads(8, 8, 8)]
void CS_GenerateNoise(uint3 id : SV_DISPATCHTHREADID) {
    float3 pos = float3(id.xyz);
    float n = 0.0f, G = exp2(-1), f = 1.0f, a = 1.0f;
    for (int i = 0; i < _Octaves; ++i) {
        n += worley(pos.xyz * f + i * _Warp, _AxisCellCount * f) * a;
        f *= 2.0f; a *= G;
    }
    n = saturate(n + _Add) * _Amplitude;
    _RWNoiseTex[id.xyz] = _InvertNoise ? _Amplitude - n : n;
}


// ── Debug noise plane ─────────────────────────────────────────────────────────

uint _DebugNoiseSlice, _DebugAxis, _DebugTiledNoise;

float RaymarchNoisePlane(float3 rayOrigin, float3 rayDir) {
    float distance = 0.0f;
    float3 n = 0;
    if (_DebugAxis == 0) n.x = 1;
    if (_DebugAxis == 1) n.y = 1;
    if (_DebugAxis == 2) n.z = 1;
    for (int i = 0; i < STEPS && distance < MAX_DISTANCE; ++i) {
        float3 pos = rayOrigin + distance * rayDir;
        float d = max(dot(pos, -n), dot(pos, n));
        distance += d;
        if (d < MIN_HIT_DISTANCE) return distance;
    }
    return MAX_DISTANCE;
}

[numthreads(8, 8, 1)]
void CS_DebugNoise(uint3 id : SV_DISPATCHTHREADID) {
    float3 origin = _CameraWorldPos;
    // On D3D / Metal the render texture has Y=0 at the top. Flip so that
    // thread row 0 maps to screen-bottom (clip-y = -1), matching the composite.
    float2 screenUV = id.xy / float2(_BufferWidth, _BufferHeight);
    if (_FlipY) screenUV.y = 1.0 - screenUV.y;
    float2 uv = screenUV * 2 - 1;
    float3 direction = mul(_CameraInvProjection, float4(uv, 1.0f, 1.0f)).xyz;
    direction = normalize(mul(_CameraToWorld, float4(direction, 0.0f)).xyz);

    float d = RaymarchNoisePlane(origin, direction);
    float4 col = 0.0f;
    if (d < MAX_DISTANCE) {
        float3 pos = origin + direction * d;
        if ((all(pos > 0) && all(pos < 1)) || _DebugTiledNoise) {
            if (_DebugAxis == 0) pos.x = (_DebugNoiseSlice - 1) / _NoiseRes.x;
            if (_DebugAxis == 1) pos.y = (_DebugNoiseSlice - 1) / _NoiseRes.y;
            if (_DebugAxis == 2) pos.z = (_DebugNoiseSlice - 1) / _NoiseRes.z;
            col.rgb = _NoiseTex.SampleLevel(linear_repeat_sampler, pos, 0).r;
        }
    }
    _SmokeTex[id.xy] = col;
}


// ── Utility ───────────────────────────────────────────────────────────────────

float3 ComputeWorldSpacePosition(float2 positionNDC, float deviceDepth) {
    float4 positionCS = float4(positionNDC * 2.0 - 1.0, deviceDepth, 1.0);
    float4 hpositionWS = mul(_CameraInvViewProjection, positionCS);
    return hpositionWS.xyz / hpositionWS.w;
}

// Converts a world-space position to [0,1] UVW within the fixed smoke volume.
// Volume spans: X in [-BoundsExtent.x, BoundsExtent.x],
//               Y in [0, 2*BoundsExtent.y],
//               Z in [-BoundsExtent.z, BoundsExtent.z]
float3 worldToSmokeUVW(float3 worldPos) {
    float3 uvw = worldPos;
    uvw.xz += _BoundsExtent.xz;
    uvw /= _BoundsExtent * 2;
    return uvw;
}

bool inSmokeBounds(float3 uvw) {
    return all(uvw >= 0.0f) && all(uvw <= 1.0f);
}


// ── Phase functions ───────────────────────────────────────────────────────────

float HenyeyGreenstein(float g, float cos_theta) {
    float denom = 1.0f + g * g - 2.0f * g * cos_theta;
    return (1.0f / (4.0f * PI)) * ((1.0f - g * g) / (denom * sqrt(denom)));
}

float Mie(float g, float cos_theta) {
    float denom = 1.0f + g * g - 2.0f * g * cos_theta;
    return (3.0f / (8.0f * PI)) * (((1 - g * g) * (1 + cos_theta * cos_theta)) / ((2.0f + g * g) * (denom * sqrt(denom))));
}

float Rayleigh(float cos_theta) {
    return (3.0f / (16.0f * PI)) * (1 + cos_theta * cos_theta);
}

float phase(float g, float cos_theta) {
    if (_PhaseFunction == 0) return HenyeyGreenstein(g, cos_theta);
    if (_PhaseFunction == 1) return Mie(g, cos_theta);
    return Rayleigh(cos_theta);
}


// ── Density sampling (Overhaul 2: hardware texture replaces manual 8-tap lerp) ──

float getNoise(float3 pos) {
    return _NoiseTex.SampleLevel(linear_repeat_sampler, pos / _SmokeSize + _AnimationDirection * _FrameTime, 0).r;
}

// Returns smoke voxel density at worldPos using hardware trilinear sampling.
// This replaces both getVoxel() (integer) and getTrilinearVoxel() (manual 8-tap).
float sampleSmokeVoxels(float3 worldPos) {
    float3 uvw = worldToSmokeUVW(worldPos);
    if (!inSmokeBounds(uvw)) return 0.0f;
    return _SmokeVoxelTex.SampleLevel(linear_clamp_sampler, uvw, 0).r;
}

// Integer occupancy test for early-exit traversal (point sampling, no interpolation).
int getVoxel(float3 worldPos) {
    float3 uvw = worldToSmokeUVW(worldPos);
    if (!inSmokeBounds(uvw)) return 0;
    return _SmokeVoxelTex.SampleLevel(point_repeat_sampler, uvw, 0).r > 0.0f ? 1 : 0;
}

float getDensity(float3 pos) {
    float3 vp     = pos - _SmokeOrigin;
    // Guard against zero radius to avoid NaN
    float3 radius = max(_Radius - 0.1f, float3(0.001f, 0.001f, 0.001f));

    float v = sampleSmokeVoxels(pos);
    float n = getNoise(pos);

    // Normalised distance from smoke origin, clamped to [0,1].
    // voxelDist turns empty voxels (v≈0) into dist=1 so they always fade out.
    float dist      = min(1.0f, length(vp / radius));
    float voxelDist = min(1.0f, 1.0f - v);
    dist = max(dist, voxelDist);

    // Noise perturbs the edge boundary ±0.15 to create turbulent smoke edges.
    //   n ∈ [0,1] (Worley: 1 at cell centres, 0 at edges)
    //   (0.5 - n)*0.3  →  n>0.5 pushes boundary outward, n<0.5 pushes inward.
    // The interior (dist≈0) is NOT affected — it always stays fully opaque.
    // This removes the "transparent spheres" and "mostly transparent smoke" bugs
    // that occurred when noise was fed directly into the falloff value.
    float perturbedDist = saturate(dist + (0.5f - n) * 0.3f);
    float edgeFade = 1.0f - smoothstep(_DensityFalloff, 1.0f, perturbedDist);

    return saturate(v * edgeFade);
}


// ── CS_BuildBulletHoleMask ────────────────────────────────────────────────────
//
// Rebuilds the bullet hole bitmask texture each frame from the current set of
// animated BulletHole capsules. Cost: O(totalVoxels × bulletHoleCount) on the
// compute side — paid once per frame rather than per-pixel inside getDensity().
// No noise is baked here; noise is added at sample time in CS_RayMarchSmoke so
// edge softening remains view-aligned and doesn't alias with the voxel grid.

[numthreads(4, 4, 8)]
void CS_BuildBulletHoleMask(uint3 id : SV_DISPATCHTHREADID) {
    if (any(id >= uint3(_VoxelResolution))) return;

    // Reconstruct world position of this voxel center
    float3 worldPos = float3(id) * _VoxelSize + _VoxelSize * 0.5f;
    worldPos.xz -= _BoundsExtent.xz;

    float minDist = 1.0f;

    for (int i = 0; i < _BulletHoleCount; ++i) {
        BulletHole bh = _BulletHoles[i];

        float3 a = bh.origin;
        float3 b = a + _BulletDepth * bh.forward;
        float  r1 = bh.radius.x;
        float  r2 = bh.radius.y;

        // Analytic capped-cone (tapered capsule) SDF
        float3 p  = worldPos;
        float3 ba = b - a;
        float  l2 = dot(ba, ba);
        float  rr = r1 - r2;
        float  a2 = l2 - rr * rr;
        float  il2 = 1.0f / l2;

        float3 pa = p - a;
        float  y  = dot(pa, ba);
        float  z  = y - l2;
        float3 tmp = pa * l2 - ba * y;
        float  x2 = dot(tmp, tmp);
        float  y2 = y * y * l2;
        float  z2 = z * z * l2;

        float k = sign(rr) * rr * rr * x2;
        float dist;
        if      (sign(z) * a2 * z2 > k) dist = sqrt(x2 + z2) * il2 - r2;
        else if (sign(y) * a2 * y2 < k) dist = sqrt(x2 + y2) * il2 - r1;
        else                             dist = (sqrt(x2 * a2 * il2) + y * rr) * il2 - r1;

        // Smooth threshold: result is 0 inside hole, 1 outside
        minDist = min(minDist, smoothstep(0.75f, 1.0f, saturate(dist)));
    }

    _BulletHoleMaskTexRW[id] = minDist;
}


// ── CS_RayMarchSmoke ──────────────────────────────────────────────────────────

[numthreads(8, 8, 1)]
void CS_RayMarchSmoke(uint3 id : SV_DispatchThreadID) {
    // On D3D / Metal render textures have Y=0 at the top.
    // Flip the per-pixel UV so ray row 0 aims at screen-bottom (clip-y = -1),
    // which matches the orientation used by the composite shader when it samples
    // _SmokeTex and _DepthTex via Graphics.Blit UVs.
    float2 uv = id.xy / float2(_BufferWidth, _BufferHeight);
    if (_FlipY) uv.y = 1.0 - uv.y;

    float  sceneDepth    = _DepthTex.SampleLevel(linear_clamp_sampler, uv, 0).r;
    float3 sceneWorldPos = ComputeWorldSpacePosition(uv, sceneDepth);

    float3 origin = _CameraWorldPos;
    float3 rayDir = mul(_CameraInvProjection, float4(uv * 2 - 1, 0.0f, 1.0f)).xyz;
    rayDir = normalize(mul(_CameraToWorld, float4(rayDir, 0.0f)).xyz);

    float3 col   = 0.0f;
    float  alpha = 1.0f;

    float distanceTraveled = 0;
    float3 samplePos = origin;
    float  v = getVoxel(samplePos);

    // Project the vector to the scene surface onto the ray direction.
    // The old formula used only the X component: -((origin-scene)/rayDir).x
    // which produces infinity / wrong-sign values when rayDir.x ≈ 0 (i.e. when
    // looking straight ahead, the normal case in an FPS). dot() gives the
    // correct signed t parameter along the ray on all view angles.
    float sceneIntersectDistance = max(0.0f, min((float)MAX_DISTANCE,
                                        dot(sceneWorldPos - origin, rayDir)));

    // Early-out: skip empty space with 0.4-unit steps (integer voxel check only)
    while (v == 0 && distanceTraveled < MAX_DISTANCE) {
        distanceTraveled += 0.4;
        samplePos = origin + distanceTraveled * rayDir;
        v = getVoxel(samplePos);
    }

    if (v) {
        distanceTraveled -= 0.4f; // step back to avoid skipping thin details

        float extinctionCoefficient = _AbsorptionCoefficient + _ScatteringCoefficient;
        float cos_theta = dot(rayDir, float3(0, 1, 0));
        float p = phase(_G, cos_theta);
        float stepSize  = _StepSize;
        float lStepSize = _LightStepSize;
        float accumDensity = 0.0f;
        float thickness    = 0.0f;
        col = _SmokeColor;

        sceneIntersectDistance = max(0.0f, min((float)MAX_DISTANCE,
                                        dot(sceneWorldPos - origin, rayDir)));
        int stepCount = 0;

        while (stepCount < _StepCount && distanceTraveled < sceneIntersectDistance) {
            samplePos = origin + distanceTraveled * rayDir;

            // Density: hardware-trilinear texture sample * bullet hole mask * noise
            float density = getDensity(samplePos);
            float3 maskUVW = worldToSmokeUVW(samplePos);
            float  bulletMask = inSmokeBounds(maskUVW)
                ? _BulletHoleMaskTex.SampleLevel(linear_clamp_sampler, maskUVW, 0).r
                : 1.0f;
            // Blend noise into mask edges at render time (view-consistent softening)
            bulletMask = min(1.0f, bulletMask + getNoise(samplePos) * 0.2f);

            v = density * bulletMask;
            float sampleDensity = v;
            accumDensity += sampleDensity * _VolumeDensity;

            ++stepCount;
            distanceTraveled += stepSize;
            thickness += stepSize * sampleDensity;
            alpha = exp(-thickness * accumDensity * extinctionCoefficient);

            if (sampleDensity > 0.001f) {
                float  tau      = 0.0f;
                float3 lightPos = samplePos;
                int    lStep    = 0;
                while (lStep < _LightStepCount) {
                    // Shadow ray: single integer voxel lookup (no trilinear needed for shadows)
                    tau += getDensity(lightPos) * _ShadowDensity;
                    lightPos -= lStepSize * float3(0, -1, 0);
                    ++lStep;
                }
                float3 lightAtten = exp(-(tau / _ExtinctionColor) * extinctionCoefficient * _ShadowDensity);
                col += _LightColor * lightAtten * alpha * p * _ScatteringCoefficient * _VolumeDensity * sampleDensity;
            }

            if (alpha < _AlphaThreshold) break;
        }

        // Final in-between sample at scene depth (handles overshoot)
        if (distanceTraveled > sceneIntersectDistance) {
            samplePos    -= (distanceTraveled - sceneIntersectDistance) * rayDir;
            thickness    -= distanceTraveled - sceneIntersectDistance;

            float density = getDensity(samplePos);
            float3 maskUVW = worldToSmokeUVW(samplePos);
            float  bulletMask = inSmokeBounds(maskUVW)
                ? _BulletHoleMaskTex.SampleLevel(linear_clamp_sampler, maskUVW, 0).r
                : 1.0f;
            bulletMask = min(1.0f, bulletMask + getNoise(samplePos) * 0.2f);

            v = density * bulletMask;
            accumDensity += _VolumeDensity * v;
            alpha = exp(-thickness * accumDensity * extinctionCoefficient);

            if (v > 0.001f) {
                float  tau      = 0.0f;
                float3 lightPos = samplePos;
                int    lStep    = 0;
                while (lStep < _LightStepCount) {
                    tau += getDensity(lightPos) * _ShadowDensity;
                    lightPos -= lStepSize * float3(0, -1, 0);
                    ++lStep;
                }
                float3 lightAtten = exp(-(tau / _ExtinctionColor) * extinctionCoefficient * _ShadowDensity);
                col += _LightColor * lightAtten * alpha * p * _ScatteringCoefficient * _VolumeDensity * v;
            }
        }

        if (alpha < _AlphaThreshold) alpha = 0;
    }

    _SmokeTex[id.xy]     = float4(saturate(col), 1.0f);
    _SmokeMaskTex[id.xy] = saturate(alpha);
}
