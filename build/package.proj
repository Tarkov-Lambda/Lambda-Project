<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configuration>Release</Configuration>
        <OutputRoot>$(MSBuildThisFileDirectory)out\</OutputRoot>
        <PackageRoot>$(OutputRoot)package\</PackageRoot>
        <ZipFile>$(OutputRoot)arena.zip</ZipFile>
    </PropertyGroup>

    <!-- Build everything -->
    <Target Name="BuildAll">
        <MSBuild Projects="..\fika.arena.sln" Targets="Build"
            Properties="Configuration=$(Configuration)" />
    </Target>

    <!-- Collect files -->
    <Target Name="Collect" DependsOnTargets="BuildAll">

        <ItemGroup>
            <!-- Core -->
            <HotLoadablePlugin Include="..\arena.bep\bin\Release\*.dll" />

            <!-- Shared -->
            <Plugin Include="..\arena.shared\bin\Release\*.dll" />

            <!-- Audio -->
            <Plugin Include="..\arena.audio\bin\Release\*.dll" />

            <!-- UI -->
            <Plugin Include="..\arena.ui\bin\Release\*.dll" />

            <!-- Dependencies -->
            <Deps Include="..\deps\libraries\*.dll" />

            <!-- Bundles -->
            <Bundles Include="$(SPTPath)\BepInEx\plugins\ifp\bundles\fx" />
            <Bundles Include="$(SPTPath)\BepInEx\plugins\ifp\bundles\audio" />
            <Bundles Include="$(SPTPath)\BepInEx\plugins\ifp\bundles\arenaui" />
            <Bundles Include="$(SPTPath)\BepInEx\plugins\ifp\bundles\lobby" />
            <Bundles Include="$(SPTPath)\BepInEx\plugins\ifp\bundles\samplelevel" />

            <!-- Config -->
            <Config Include="..\deps\configs\*.jsonc" />
        </ItemGroup>

        <Copy SourceFiles="@(Plugin)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\ifp" />
        <Copy SourceFiles="@(Deps)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\ifp\deps" />
        <Copy SourceFiles="@(Bundles)" DestinationFolder="$(PackageRoot)\BepInEx\plugins\ifp\bundles" />
        <Copy SourceFiles="@(Config)" DestinationFolder="$(PackageRoot)\BepInEx\config" />

    </Target>

    <!-- Zip -->
    <Target Name="Zip" DependsOnTargets="Collect">
        <Exec Command="powershell -Command &quot;Compress-Archive -Path '$(PackageRoot)\*' -DestinationPath '$(ZipFile)' -Force&quot;" />
    </Target>

    <Target Name="Default" DependsOnTargets="Zip" />

</Project>